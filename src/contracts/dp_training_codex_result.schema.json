{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["implemented", "incomplete", "needs_more_information", "requires_external_system"]
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{40}$"
    },
    "compiled": {"type": "boolean"},
    "focused_tests_passed": {"type": "boolean"},
    "affected_tests_passed": {"type": "boolean"},
    "tracker_passed": {"type": "boolean"},
    "git_safety_passed": {"type": "boolean"},
    "pushed": {"type": "boolean"},
    "failure_category": {
      "type": "string",
      "enum": ["none", "business_clarification", "external_dependency", "test_failure", "workspace_conflict", "implementation_incomplete", "safety_check_failed"]
    },
    "changed_layers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Deterministic Code", "Business Context", "Taxonomy", "Prompt / Context Rendering", "Mapping", "Reference Data", "External System", "Other"]
      },
      "uniqueItems": true
    },
    "business_context_version_before": {"type": "integer", "minimum": 1},
    "business_context_version_after": {"type": "integer", "minimum": 1},
    "analysis_contract_version": {"type": "integer", "minimum": 1}
  },
  "required": [
    "outcome",
    "commit_sha",
    "compiled",
    "focused_tests_passed",
    "affected_tests_passed",
    "tracker_passed",
    "git_safety_passed",
    "pushed",
    "failure_category",
    "changed_layers",
    "business_context_version_before",
    "business_context_version_after",
    "analysis_contract_version"
  ],
  "additionalProperties": false
}
